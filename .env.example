# Copy to .env for Docker Compose. For native Python, set these in your environment.
# Choose a long random token, used to open the app. Do not commit the real .env.
APP_TOKEN=replace-with-a-long-random-secret
GMAIL_ACCOUNT=investmalaysia2025@gmail.com
# Optional: Google OAuth credentials with gmail.readonly scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Poll every 15 minutes when all Gmail credentials are present. 0 disables polling.
GMAIL_POLL_SECONDS=900
