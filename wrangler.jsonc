{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradingbot",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./static", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "tradingbot-research", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "vars": { "GMAIL_ACCOUNT": "investmalaysia2025@gmail.com" },
  "triggers": { "crons": ["*/15 * * * *"] }
}
